@model IEnumerable<SchoolMaterials.Models.MaterialRequest>
@{
    ViewData["Title"] = "Заявки за материали";
}

<h2>Заявки за материали</h2>

@if (User.IsInRole("Teacher"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Създай нова заявка</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Номер</th>
            <th>Дата</th>
            <th>Описание</th>
            <th>Количество</th>
            <th>Статус</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RequestNumber</td>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.Description</td>
                <td>@item.Quantity</td>
                <td>
                    @if (item.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Изчаква</span>
                    }
                    else if (item.Status == "Approved")
                    {
                        <span class="badge bg-success">Одобрена</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Отхвърлена</span>
                    }
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @if (item.Status == "Pending")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="status" value="Approved" />
                                <button type="submit" class="btn btn-sm btn-success">Одобри</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="status" value="Rejected" />
                                <button type="submit" class="btn btn-sm btn-danger">Отхвърли</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>